<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="180dp"
    android:layout_height="wrap_content"
    android:minWidth="180dp"
    android:background="@drawable/bg_stat_card"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingTop="14dp"
    android:paddingBottom="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.anokix.distributorapp.ui.views.RobotoTextView
            android:id="@+id/summaryLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Total Revenue"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <FrameLayout
            android:id="@+id/summaryIconContainer"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_kpi_icon_purple">

            <ImageView
                android:id="@+id/summaryIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_wallet"
                app:tint="@color/purple_primary" />
        </FrameLayout>
    </LinearLayout>

    <com.anokix.distributorapp.ui.views.RobotoBoldTextView
        android:id="@+id/summaryValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="R1,245,600.00"
        android:textColor="@color/text_primary"
        android:textSize="18sp" />

    <com.anokix.distributorapp.ui.views.RobotoBoldTextView
        android:id="@+id/summaryTrend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="↑ 100.0%"
        android:textColor="@color/success"
        android:textSize="12sp" />

    <com.anokix.distributorapp.ui.views.RobotoLightTextView
        android:id="@+id/summaryCompare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="vs 6 - 12 Jul 2026"
        android:textColor="@color/text_secondary"
        android:textSize="10sp" />

    <View
        android:id="@+id/summaryUnderline"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="14dp" />

</LinearLayout>
