<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:minWidth="200dp"
    android:background="@drawable/bg_stat_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.anokix.distributor.ui.views.RobotoTextView
            android:id="@+id/summaryLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Total Revenue"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <FrameLayout
            android:id="@+id/summaryIconContainer"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_kpi_icon_purple">

            <ImageView
                android:id="@+id/summaryIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_wallet"
                app:tint="@color/purple_primary" />
        </FrameLayout>
    </LinearLayout>

    <com.anokix.distributor.ui.views.RobotoBoldTextView
        android:id="@+id/summaryValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="R1,245,600.00"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />

    <com.anokix.distributor.ui.views.RobotoBoldTextView
        android:id="@+id/summaryTrend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_growth_badge"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="↑ 18.6%"
        android:textColor="@color/success"
        android:textSize="10sp" />

    <com.anokix.distributor.ui.views.SparklineView
        android:id="@+id/summarySparkline"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp" />

</LinearLayout>
