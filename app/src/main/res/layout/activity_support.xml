<?xml version="1.0" encoding="utf-8"?>
<!--
  Support Centre (New-Design/Support Centre/1.Dashboard.png).

  The web page's System Health and Knowledge Base panels are not ported — the
  requirements mark both as unused, and on a phone they would push the two things that
  matter (how to reach support, and your tickets) below the fold.

  Contact cards render only for the channels the API reports as enabled, and the help
  section only appears once there is something to show, so the page never displays a
  row of dead controls.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <include layout="@layout/include_secondary_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Search -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_search_bar"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search"
                        app:tint="@color/text_secondary" />

                    <com.anokix.distributorapp.ui.views.RobotoEditText
                        android:id="@+id/searchInput"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:gravity="center_vertical"
                        android:hint="@string/support_search_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingVertical="0dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/searchClear"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/clear"
                        android:src="@drawable/ic_close"
                        android:visibility="gone"
                        app:tint="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Contact channels; each card is added in code for the channels that are on. -->
            <LinearLayout
                android:id="@+id/channelsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp" />

            <com.anokix.distributorapp.ui.views.RobotoTextView
                android:id="@+id/supportHours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:drawableStart="@drawable/ic_clock"
                android:drawablePadding="6dp"
                android:drawableTint="@color/text_tertiary"
                android:paddingHorizontal="16dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Help articles: search results, or the popular list when nothing is typed. -->
            <LinearLayout
                android:id="@+id/articlesSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="20dp"
                android:visibility="gone">

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:id="@+id/articlesTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/support_popular_topics"
                    android:textColor="@color/top_title"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/articlesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    android:id="@+id/articlesEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="20dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Tickets -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="22dp">

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/support_my_tickets"
                    android:textColor="@color/top_title"
                    android:textSize="16sp" />

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:id="@+id/newTicketButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="4dp"
                    android:text="@string/support_new_ticket"
                    android:textColor="@color/purple_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ticketsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:paddingHorizontal="16dp" />

            <com.anokix.distributorapp.ui.views.RobotoTextView
                android:id="@+id/ticketsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:paddingVertical="32dp"
                android:text="@string/support_tickets_empty"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
