<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <include layout="@layout/include_secondary_header" />

    <ScrollView
        android:id="@+id/businessScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:contentPadding="16dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.anokix.distributor.ui.views.RobotoBoldTextView
                        style="@style/StoreFieldLabel"
                        android:layout_marginTop="0dp"
                        android:text="@string/business_name_req" />

                    <com.anokix.distributor.ui.views.RobotoEditText
                        android:id="@+id/etBusinessName"
                        style="@style/StoreFieldInput"
                        android:hint="@string/hint_business_name"
                        android:inputType="textCapWords" />

                    <com.anokix.distributor.ui.views.RobotoBoldTextView
                        style="@style/StoreFieldLabel"
                        android:text="@string/registration_number_label" />

                    <com.anokix.distributor.ui.views.RobotoEditText
                        android:id="@+id/etRegistrationNumber"
                        style="@style/StoreFieldInput"
                        android:hint="@string/hint_business_reg"
                        android:inputType="text" />

                    <com.anokix.distributor.ui.views.RobotoBoldTextView
                        style="@style/StoreFieldLabel"
                        android:text="@string/vat_number_label" />

                    <com.anokix.distributor.ui.views.RobotoEditText
                        android:id="@+id/etVatNumber"
                        style="@style/StoreFieldInput"
                        android:hint="@string/hint_vat_number"
                        android:inputType="text" />

                    <com.anokix.distributor.ui.views.RobotoBoldTextView
                        style="@style/StoreFieldLabel"
                        android:text="@string/address_of_business" />

                    <com.anokix.distributor.ui.views.RobotoEditText
                        android:id="@+id/etAddressSearch"
                        style="@style/StoreFieldInput"
                        android:hint="@string/search_address_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text" />

                    <com.anokix.distributor.ui.views.RobotoTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/map_pin_hint_trader"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <com.google.android.gms.maps.MapView
                        android:id="@+id/businessMap"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginTop="12dp" />

                    <com.anokix.distributor.ui.views.RobotoBoldTextView
                        style="@style/StoreFieldLabel"
                        android:text="@string/city_label" />

                    <com.anokix.distributor.ui.views.RobotoEditText
                        android:id="@+id/etCity"
                        style="@style/StoreFieldInput"
                        android:hint="@string/hint_city"
                        android:inputType="textCapWords" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/include_settings_form_footer" />
</LinearLayout>
