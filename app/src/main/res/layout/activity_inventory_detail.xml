<?xml version="1.0" encoding="utf-8"?>
<!-- Inventory item drawer (New-Design/Inventory 2.Item-Details / 3.Item-History). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <include layout="@layout/include_secondary_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp">

        <LinearLayout
            android:id="@+id/tabDetailsWrap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:background="?attr/selectableItemBackground"
            android:orientation="vertical">

            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                android:id="@+id/tabDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="6dp"
                android:text="@string/inventory_details"
                android:textColor="@color/purple_primary"
                android:textSize="@dimen/text_body" />

            <View
                android:id="@+id/tabDetailsIndicator"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@drawable/bg_tab_indicator_purple" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabHistoryWrap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:orientation="vertical">

            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                android:id="@+id/tabHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="6dp"
                android:text="@string/inventory_history"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body" />

            <View
                android:id="@+id/tabHistoryIndicator"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@drawable/bg_tab_indicator_purple"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== Details ===== -->
            <LinearLayout
                android:id="@+id/detailsPane"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/detailRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_stat_card"
                    android:orientation="vertical"
                    android:padding="4dp" />

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/inventory_where_units_sit"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_title" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/breakdownContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- ===== History ===== -->
            <LinearLayout
                android:id="@+id/historyPane"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <com.anokix.distributorapp.ui.views.RobotoTextView
                android:id="@+id/historyEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:text="@string/inventory_no_history"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
