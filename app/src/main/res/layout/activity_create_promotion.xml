<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/purple_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:rotation="180"
            android:src="@drawable/ic_chevron_right"
            app:tint="@android:color/white" />

        <com.anokix.distributor.ui.views.RobotoBoldTextView
            android:id="@+id/screenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/create_promotion_title"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Stepper -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/stepperContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp" />
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <ViewFlipper
        android:id="@+id/stepFlipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===== Step 1: Type ===== -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.anokix.distributor.ui.views.RobotoBoldTextView
                    style="@style/PromoStepTitle"
                    android:text="@string/promo_step_type_title" />

                <com.anokix.distributor.ui.views.RobotoTextView
                    style="@style/PromoStepSubtitle"
                    android:text="@string/promo_step_type_sub" />

                <com.anokix.distributor.ui.views.FlowLayout
                    android:id="@+id/typeContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ===== Step 2: Details ===== -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.anokix.distributor.ui.views.RobotoBoldTextView
                    style="@style/PromoStepTitle"
                    android:text="@string/promo_step_details_title" />

                <com.anokix.distributor.ui.views.RobotoTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/promo_campaign_name" />

                <com.anokix.distributor.ui.views.RobotoEditText
                    android:id="@+id/etCampaignName"
                    style="@style/StoreFieldInput"
                    android:hint="@string/promo_campaign_name_hint"
                    android:inputType="textCapWords" />

                <com.anokix.distributor.ui.views.RobotoTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/promo_objective" />

                <LinearLayout
                    android:id="@+id/objectiveField"
                    style="@style/ProductDropdown">

                    <com.anokix.distributor.ui.views.RobotoTextView
                        android:id="@+id/objectiveLabel"
                        style="@style/ProductDropdownLabel"
                        android:text="@string/promo_select_objective" />

                    <ImageView style="@style/ProductDropdownChevron" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.anokix.distributor.ui.views.RobotoTextView
                            style="@style/StoreFieldLabel"
                            android:text="@string/promo_start_date" />

                        <LinearLayout
                            android:id="@+id/startDateField"
                            style="@style/ProductDropdown">

                            <com.anokix.distributor.ui.views.RobotoTextView
                                android:id="@+id/startDateLabel"
                                style="@style/ProductDropdownLabel"
                                android:text="@string/promo_select_date" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_calendar"
                                app:tint="@color/text_secondary" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.anokix.distributor.ui.views.RobotoTextView
                            style="@style/StoreFieldLabel"
                            android:text="@string/promo_end_date" />

                        <LinearLayout
                            android:id="@+id/endDateField"
                            style="@style/ProductDropdown">

                            <com.anokix.distributor.ui.views.RobotoTextView
                                android:id="@+id/endDateLabel"
                                style="@style/ProductDropdownLabel"
                                android:text="@string/promo_select_date" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_calendar"
                                app:tint="@color/text_secondary" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.anokix.distributor.ui.views.RobotoTextView
                            style="@style/StoreFieldLabel"
                            android:text="@string/promo_budget" />

                        <com.anokix.distributor.ui.views.RobotoEditText
                            android:id="@+id/etBudget"
                            style="@style/StoreFieldInput"
                            android:hint="5000.00"
                            android:inputType="numberDecimal" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.anokix.distributor.ui.views.RobotoTextView
                            style="@style/StoreFieldLabel"
                            android:text="@string/promo_daily_budget" />

                        <com.anokix.distributor.ui.views.RobotoEditText
                            android:id="@+id/etDailyBudget"
                            style="@style/StoreFieldInput"
                            android:hint="500.00"
                            android:inputType="numberDecimal" />
                    </LinearLayout>
                </LinearLayout>

                <com.anokix.distributor.ui.views.RobotoTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/promo_description" />

                <com.anokix.distributor.ui.views.RobotoEditText
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_login_input"
                    android:gravity="top|start"
                    android:hint="@string/promo_description_hint"
                    android:inputType="textMultiLine"
                    android:padding="12dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ===== Step 3: Targeting ===== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/step3Scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.anokix.distributor.ui.views.RobotoBoldTextView
                    style="@style/PromoStepTitle"
                    android:text="@string/promo_step_targeting_title" />

                <com.anokix.distributor.ui.views.RobotoTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/promo_business_address" />

                <com.anokix.distributor.ui.views.RobotoEditText
                    android:id="@+id/etAddressSearch"
                    style="@style/StoreFieldInput"
                    android:hint="@string/promo_search_address"
                    android:inputType="text" />

                <com.google.android.gms.maps.MapView
                    android:id="@+id/promoMap"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="10dp" />

                <com.anokix.distributor.ui.views.RobotoTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/promo_trader_segments" />

                <com.anokix.distributor.ui.views.RobotoTextView
                    style="@style/PromoStepSubtitle"
                    android:text="@string/promo_trader_segments_sub" />

                <com.anokix.distributor.ui.views.FlowLayout
                    android:id="@+id/segmentContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ===== Step 4: Creative ===== -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.anokix.distributor.ui.views.RobotoBoldTextView
                    style="@style/PromoStepTitle"
                    android:text="@string/promo_step_creative_title" />

                <com.anokix.distributor.ui.views.RobotoTextView
                    style="@style/PromoStepSubtitle"
                    android:text="@string/promo_step_creative_sub" />

                <!-- Tabs -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <com.anokix.distributor.ui.views.RobotoBoldTextView
                        android:id="@+id/tabImage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingVertical="10dp"
                        android:text="@string/promo_tab_banner"
                        android:textColor="@color/purple_primary"
                        android:textSize="14sp" />

                    <com.anokix.distributor.ui.views.RobotoBoldTextView
                        android:id="@+id/tabVideo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingVertical="10dp"
                        android:text="@string/promo_tab_video"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border" />

                <!-- Image upload -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardCornerRadius="12dp">

                    <FrameLayout
                        android:id="@+id/imageUploadBox"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:background="@drawable/bg_upload_dashed"
                        android:padding="1.5dp">

                        <LinearLayout
                            android:id="@+id/imagePlaceholder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_add"
                                app:tint="@color/purple_primary" />

                            <com.anokix.distributor.ui.views.RobotoTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/promo_upload_banner"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/imagePreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter"
                            android:visibility="gone" />
                    </FrameLayout>

                </androidx.cardview.widget.CardView>

                <!-- Video upload -->
                <FrameLayout
                    android:id="@+id/videoUploadBox"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_upload_dashed"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_add"
                            app:tint="@color/purple_primary" />

                        <com.anokix.distributor.ui.views.RobotoTextView
                            android:id="@+id/videoLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="@string/promo_upload_video"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ===== Step 5: Products ===== -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.anokix.distributor.ui.views.RobotoBoldTextView
                    style="@style/PromoStepTitle"
                    android:text="@string/promo_step_products_title" />

                <com.anokix.distributor.ui.views.RobotoTextView
                    style="@style/PromoStepSubtitle"
                    android:text="@string/promo_step_products_sub" />

                <!-- Single Products -->
                <LinearLayout style="@style/PromoSectionHeader">

                    <com.anokix.distributor.ui.views.RobotoBoldTextView
                        android:id="@+id/singleHeader"
                        style="@style/PromoSectionTitle"
                        android:text="@string/promo_single_products" />

                    <com.anokix.distributor.ui.views.RobotoBoldTextView
                        android:id="@+id/btnAddSingle"
                        style="@style/PromoAddButton"
                        android:text="@string/promo_add" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/singleContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Combo Deals -->
                <LinearLayout style="@style/PromoSectionHeader">

                    <com.anokix.distributor.ui.views.RobotoBoldTextView
                        android:id="@+id/comboHeader"
                        style="@style/PromoSectionTitle"
                        android:text="@string/promo_combo_deals" />

                    <com.anokix.distributor.ui.views.RobotoBoldTextView
                        android:id="@+id/btnAddCombo"
                        style="@style/PromoAddButton"
                        android:text="@string/promo_add" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/comboContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Buy1Get1 -->
                <LinearLayout style="@style/PromoSectionHeader">

                    <com.anokix.distributor.ui.views.RobotoBoldTextView
                        android:id="@+id/b1g1Header"
                        style="@style/PromoSectionTitle"
                        android:text="@string/promo_b1g1_deals" />

                    <com.anokix.distributor.ui.views.RobotoBoldTextView
                        android:id="@+id/btnAddB1g1"
                        style="@style/PromoAddButton"
                        android:text="@string/promo_add" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/b1g1Container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ===== Step 6: Budget ===== -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.anokix.distributor.ui.views.RobotoBoldTextView
                    style="@style/PromoStepTitle"
                    android:text="@string/promo_step_budget_title" />

                <com.anokix.distributor.ui.views.RobotoBoldTextView
                    style="@style/PromoCardTitle"
                    android:layout_marginTop="10dp"
                    android:text="@string/promo_budget_summary" />

                <LinearLayout
                    android:id="@+id/budgetSummaryCard"
                    style="@style/PromoCard">

                    <com.anokix.distributor.ui.views.RobotoTextView
                        style="@style/PromoCardCaption"
                        android:text="@string/promo_total_budget" />

                    <com.anokix.distributor.ui.views.RobotoBoldTextView
                        android:id="@+id/budgetTotal"
                        style="@style/PromoCardValue"
                        android:text="R0" />

                    <com.anokix.distributor.ui.views.RobotoTextView
                        style="@style/PromoCardCaption"
                        android:text="@string/promo_daily_budget" />

                    <com.anokix.distributor.ui.views.RobotoBoldTextView
                        android:id="@+id/budgetDaily"
                        style="@style/PromoCardValue"
                        android:text="R0" />

                    <com.anokix.distributor.ui.views.RobotoTextView
                        style="@style/PromoCardCaption"
                        android:text="@string/promo_duration" />

                    <com.anokix.distributor.ui.views.RobotoBoldTextView
                        android:id="@+id/budgetDuration"
                        style="@style/PromoCardValue"
                        android:text="-" />

                    <com.anokix.distributor.ui.views.RobotoTextView
                        style="@style/PromoCardCaption"
                        android:text="@string/promo_products_cost" />

                    <com.anokix.distributor.ui.views.RobotoBoldTextView
                        android:id="@+id/budgetProductsCost"
                        style="@style/PromoCardValue"
                        android:text="R0" />

                    <com.anokix.distributor.ui.views.RobotoTextView
                        android:id="@+id/budgetBreakdown"
                        style="@style/PromoCardCaption"
                        android:text="" />
                </LinearLayout>

                <com.anokix.distributor.ui.views.RobotoBoldTextView
                    style="@style/PromoCardTitle"
                    android:layout_marginTop="14dp"
                    android:text="@string/promo_estimated_performance" />

                <LinearLayout
                    android:id="@+id/estimateCard"
                    style="@style/PromoCard" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ===== Step 7: Review ===== -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.anokix.distributor.ui.views.RobotoBoldTextView
                    style="@style/PromoStepTitle"
                    android:text="@string/promo_step_review_title" />

                <LinearLayout
                    android:id="@+id/reviewCard"
                    style="@style/PromoCard" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </ViewFlipper>

    <!-- Bottom navigation bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <com.anokix.distributor.ui.views.RobotoTextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_login_input"
            android:gravity="center"
            android:minWidth="100dp"
            android:paddingHorizontal="20dp"
            android:text="@string/back_btn"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.anokix.distributor.ui.views.RobotoBoldTextView
            android:id="@+id/btnContinue"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_login_button_primary"
            android:gravity="center"
            android:minWidth="150dp"
            android:paddingHorizontal="20dp"
            android:text="@string/continue_btn"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
