<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <include layout="@layout/include_secondary_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:contentPadding="16dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.anokix.distributor.ui.views.RobotoBoldTextView
                            android:id="@+id/profileInitials"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_profile_circle"
                            android:gravity="center"
                            android:text="C"
                            android:textColor="@color/purple_primary"
                            android:textSize="22sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.anokix.distributor.ui.views.RobotoBoldTextView
                                android:id="@+id/profileDisplayName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />

                            <com.anokix.distributor.ui.views.RobotoTextView
                                android:id="@+id/profileCompanyName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp"
                        android:background="@color/border" />

                    <com.anokix.distributor.ui.views.RobotoBoldTextView
                        style="@style/StoreFieldLabel"
                        android:layout_marginTop="0dp"
                        android:text="@string/first_name_req" />

                    <com.anokix.distributor.ui.views.RobotoEditText
                        android:id="@+id/etFirstName"
                        style="@style/StoreFieldInput"
                        android:inputType="textCapWords" />

                    <com.anokix.distributor.ui.views.RobotoBoldTextView
                        style="@style/StoreFieldLabel"
                        android:text="@string/last_name_req" />

                    <com.anokix.distributor.ui.views.RobotoEditText
                        android:id="@+id/etLastName"
                        style="@style/StoreFieldInput"
                        android:inputType="textCapWords" />

                    <com.anokix.distributor.ui.views.RobotoBoldTextView
                        style="@style/StoreFieldLabel"
                        android:text="@string/email_address_req" />

                    <com.anokix.distributor.ui.views.RobotoEditText
                        android:id="@+id/etEmail"
                        style="@style/StoreFieldInput"
                        android:inputType="textEmailAddress" />

                    <com.anokix.distributor.ui.views.RobotoBoldTextView
                        style="@style/StoreFieldLabel"
                        android:text="@string/phone_label" />

                    <com.anokix.distributor.ui.views.RobotoEditText
                        android:id="@+id/etPhone"
                        style="@style/StoreFieldInput"
                        android:hint="@string/hint_phone_number"
                        android:inputType="phone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/include_settings_form_footer" />
</LinearLayout>
