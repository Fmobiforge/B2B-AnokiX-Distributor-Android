<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/finance_summary_card_width"
    android:layout_height="@dimen/finance_summary_card_height"
    android:layout_marginEnd="@dimen/spacing_sm"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="0dp"
    app:contentPadding="0dp"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <com.anokix.distributorapp.ui.views.RobotoTextView
            android:id="@+id/summaryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Revenue This Month"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_label" />

        <com.anokix.distributorapp.ui.views.RobotoBoldTextView
            android:id="@+id/summaryAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="R2.4M"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_stat_value" />

        <com.anokix.distributorapp.ui.views.RobotoTextView
            android:id="@+id/summaryTrend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="↑ 12.5% vs last month"
            android:textColor="@color/purple_primary"
            android:textSize="@dimen/text_label" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
