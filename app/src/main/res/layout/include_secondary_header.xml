<?xml version="1.0" encoding="utf-8"?>
<!-- Portal TopHeader: white bar with a hairline bottom border, boxed navy back button,
     navy semibold title and a muted subtitle. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_header_purple"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="11dp">

    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_header_back_button"
        android:contentDescription="@string/back"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_chevron_right"
        android:rotation="180"
        app:tint="@color/top_title" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.anokix.distributorapp.ui.views.RobotoBoldTextView
            android:id="@+id/screenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="-0.01"
            android:textColor="@color/top_title"
            android:textSize="@dimen/text_headline" />

        <com.anokix.distributorapp.ui.views.RobotoLightTextView
            android:id="@+id/screenSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
