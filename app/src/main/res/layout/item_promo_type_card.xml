<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_promo_type_card"
    android:gravity="center_horizontal"
    android:minHeight="@dimen/promo_type_card_min_height"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="18dp">

    <FrameLayout
        android:id="@+id/iconTile"
        android:layout_width="@dimen/promo_type_icon_tile"
        android:layout_height="@dimen/promo_type_icon_tile"
        android:background="@drawable/bg_promo_icon_purple">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/promo_type_icon_size"
            android:layout_height="@dimen/promo_type_icon_size"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <com.anokix.distributorapp.ui.views.RobotoBoldTextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/top_title"
        android:textSize="@dimen/text_title" />

    <com.anokix.distributorapp.ui.views.RobotoTextView
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_label" />
</LinearLayout>
