<?xml version="1.0" encoding="utf-8"?>
<!--
  One entry in a ticket conversation (4.Open-Ticket.png).

  The root gravity is flipped in code: our own messages sit right in a green bubble,
  support sits left in white, and a system note ("Closed by the merchant.") is centred
  as a small pill with no author.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/messageRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="vertical">

    <!-- Chat bubble -->
    <LinearLayout
        android:id="@+id/bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="300dp"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <com.anokix.distributorapp.ui.views.RobotoBoldTextView
            android:id="@+id/messageAuthor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:textColor="@color/purple_primary"
            android:textSize="11sp"
            android:visibility="gone" />

        <com.anokix.distributorapp.ui.views.RobotoTextView
            android:id="@+id/messageBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <com.anokix.distributorapp.ui.views.RobotoTextView
            android:id="@+id/messageTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="3dp"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
