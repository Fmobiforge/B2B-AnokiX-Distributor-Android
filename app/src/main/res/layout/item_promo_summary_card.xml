<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_stat_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.anokix.distributorapp.ui.views.RobotoTextView
            android:id="@+id/cardLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:text="Active Campaigns"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <FrameLayout
            android:id="@+id/cardIconContainer"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_kpi_icon_purple">

            <ImageView
                android:id="@+id/cardIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_megaphone" />
        </FrameLayout>
    </LinearLayout>

    <com.anokix.distributorapp.ui.views.RobotoBoldTextView
        android:id="@+id/cardValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="6"
        android:textColor="@color/top_title"
        android:textSize="@dimen/text_kpi_value" />

    <com.anokix.distributorapp.ui.views.RobotoTextView
        android:id="@+id/cardTrend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="↑ 100.0% vs Last Month"
        android:textColor="@color/success"
        android:textSize="11sp" />
</LinearLayout>
