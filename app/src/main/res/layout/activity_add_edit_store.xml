<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Header — include_secondary_header plus a delete action (edit mode only). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/purple_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_chevron_right"
            android:rotation="180"
            app:tint="@android:color/white" />

        <com.anokix.distributorapp.ui.views.RobotoBoldTextView
            android:id="@+id/screenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:letterSpacing="-0.01"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_headline" />

        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/delete_store"
            android:padding="8dp"
            android:src="@drawable/ic_delete"
            android:visibility="gone"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Stepper -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <com.anokix.distributorapp.ui.views.RobotoBoldTextView
            android:id="@+id/stepDot1"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_step_dot_active"
            android:gravity="center"
            android:text="1"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                android:id="@+id/stepLabel1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step_store_info"
                android:textColor="@color/purple_primary"
                android:textSize="12sp" />

            <com.anokix.distributorapp.ui.views.RobotoLightTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step_store_info_sub"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1"
            android:background="@color/border" />

        <com.anokix.distributorapp.ui.views.RobotoBoldTextView
            android:id="@+id/stepDot2"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_step_dot_inactive"
            android:gravity="center"
            android:text="2"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                android:id="@+id/stepLabel2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step_address"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.anokix.distributorapp.ui.views.RobotoLightTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step_address_sub"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <ViewFlipper
        android:id="@+id/storeFlipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ============ STEP 1: Store Information ============ -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/screen_padding_horizontal"
                android:orientation="vertical">

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step_store_info"
                    android:textAppearance="@style/TextAppearance.AnokiX.Title" />

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/store_info_sub"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:letterSpacing="0.04"
                    android:text="@string/fulfillment_options"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <!-- Fulfillment cards -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/cardClickCollect"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_fulfillment_selected"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_stores"
                                app:tint="@color/purple_primary" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                                android:id="@+id/checkCollect"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:background="@drawable/bg_step_dot_active"
                                android:gravity="center"
                                android:text="✓"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/click_collect"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <com.anokix.distributorapp.ui.views.RobotoLightTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/click_collect_sub"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardClickDeliver"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_fulfillment_selected"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_deliveries"
                                app:tint="@color/purple_primary" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                                android:id="@+id/checkDeliver"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:background="@drawable/bg_step_dot_active"
                                android:gravity="center"
                                android:text="✓"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/click_deliver"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <com.anokix.distributorapp.ui.views.RobotoLightTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/click_deliver_sub"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <com.anokix.distributorapp.ui.views.RobotoLightTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/fulfillment_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <!-- Store Name -->
                <com.anokix.distributorapp.ui.views.RobotoTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/store_name_label" />

                <com.anokix.distributorapp.ui.views.RobotoEditText
                    android:id="@+id/etName"
                    style="@style/StoreFieldInput"
                    android:inputType="textCapWords" />

                <!-- Building Number -->
                <com.anokix.distributorapp.ui.views.RobotoTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/building_number_label" />

                <com.anokix.distributorapp.ui.views.RobotoEditText
                    android:id="@+id/etBuilding"
                    style="@style/StoreFieldInput"
                    android:inputType="text" />

                <!-- Contact Number -->
                <com.anokix.distributorapp.ui.views.RobotoTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/contact_number_label" />

                <com.anokix.distributorapp.ui.views.RobotoEditText
                    android:id="@+id/etContact"
                    style="@style/StoreFieldInput"
                    android:inputType="text" />

                <!-- VAT Number -->
                <com.anokix.distributorapp.ui.views.RobotoTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/vat_number_label" />

                <com.anokix.distributorapp.ui.views.RobotoEditText
                    android:id="@+id/etVat"
                    style="@style/StoreFieldInput"
                    android:inputType="text" />

                <!-- Tags -->
                <com.anokix.distributorapp.ui.views.RobotoTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/tags_label" />

                <com.anokix.distributorapp.ui.views.RobotoEditText
                    android:id="@+id/etTag"
                    style="@style/StoreFieldInput"
                    android:hint="@string/tags_hint"
                    android:imeOptions="actionDone"
                    android:inputType="text" />

                <com.anokix.distributorapp.ui.views.RobotoLightTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/tags_help"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/tagContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- Description -->
                <com.anokix.distributorapp.ui.views.RobotoTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/store_description_label" />

                <com.anokix.distributorapp.ui.views.RobotoEditText
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_login_input"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3"
                    android:padding="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <!-- Time Zone -->
                <com.anokix.distributorapp.ui.views.RobotoTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/time_zone_label" />

                <Spinner
                    android:id="@+id/timeZoneSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_login_input"
                    android:paddingHorizontal="10dp" />

                <!-- Currency -->
                <com.anokix.distributorapp.ui.views.RobotoTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/currency_label" />

                <Spinner
                    android:id="@+id/currencySpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_login_input"
                    android:paddingHorizontal="10dp" />

                <!-- Trading Days and Times -->
                <com.anokix.distributorapp.ui.views.RobotoTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/trading_days_label" />

                <LinearLayout
                    android:id="@+id/tradingContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_login_input"
                    android:orientation="vertical"
                    android:padding="8dp" />

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:id="@+id/btnNext"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_login_button_primary"
                    android:gravity="center"
                    android:text="@string/next"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>
        </ScrollView>

        <!-- ============ STEP 2: Address & Shipping ============ -->
        <ScrollView
            android:id="@+id/step2Scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/screen_padding_horizontal"
                android:orientation="vertical">

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step_address"
                    android:textAppearance="@style/TextAppearance.AnokiX.Title" />

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/address_shipping_sub"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/address_of_store" />

                <com.anokix.distributorapp.ui.views.RobotoEditText
                    android:id="@+id/etAddressSearch"
                    style="@style/StoreFieldInput"
                    android:hint="@string/address_search_hint"
                    android:inputType="text" />

                <com.google.android.gms.maps.MapView
                    android:id="@+id/storeMap"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="10dp" />

                <com.anokix.distributorapp.ui.views.RobotoLightTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/map_pin_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/ship_information"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <com.anokix.distributorapp.ui.views.RobotoLightTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ship_information_note"
                    android:textColor="@color/danger"
                    android:textSize="10sp" />

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/street1_label" />

                <com.anokix.distributorapp.ui.views.RobotoEditText
                    android:id="@+id/etStreet1"
                    style="@style/StoreFieldInput"
                    android:inputType="text" />

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/street2_label" />

                <com.anokix.distributorapp.ui.views.RobotoEditText
                    android:id="@+id/etStreet2"
                    style="@style/StoreFieldInput"
                    android:inputType="text" />

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/suburb_label" />

                <com.anokix.distributorapp.ui.views.RobotoEditText
                    android:id="@+id/etSuburb"
                    style="@style/StoreFieldInput"
                    android:inputType="text" />

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/city_label" />

                <com.anokix.distributorapp.ui.views.RobotoEditText
                    android:id="@+id/etCity"
                    style="@style/StoreFieldInput"
                    android:inputType="text" />

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/state_label" />

                <com.anokix.distributorapp.ui.views.RobotoEditText
                    android:id="@+id/etState"
                    style="@style/StoreFieldInput"
                    android:inputType="text" />

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/country_label" />

                <com.anokix.distributorapp.ui.views.RobotoEditText
                    android:id="@+id/etCountry"
                    style="@style/StoreFieldInput"
                    android:inputType="text" />

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/postal_code_label" />

                <com.anokix.distributorapp.ui.views.RobotoEditText
                    android:id="@+id/etPostal"
                    style="@style/StoreFieldInput"
                    android:inputType="text" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                        android:id="@+id/btnBack"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_login_button_outlined"
                        android:gravity="center"
                        android:text="@string/back_btn"
                        android:textColor="@color/purple_primary"
                        android:textSize="15sp" />

                    <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                        android:id="@+id/btnSubmit"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_login_button_primary"
                        android:gravity="center"
                        android:text="@string/update_btn"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </ViewFlipper>
</LinearLayout>
