<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="22dp"
    android:orientation="vertical">

    <!-- Header: "Additional Contact N" + remove -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.anokix.distributor.ui.views.RobotoBoldTextView
            android:id="@+id/contactHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/top_title"
            android:textSize="16sp" />

        <com.anokix.distributor.ui.views.RobotoTextView
            android:id="@+id/contactRemove"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="@string/remove"
            android:textColor="@color/danger"
            android:textSize="13sp" />
    </LinearLayout>

    <com.anokix.distributor.ui.views.RobotoBoldTextView
        style="@style/StoreFieldLabel"
        android:text="@string/contact_full_name" />

    <com.anokix.distributor.ui.views.RobotoEditText
        android:id="@+id/contactName"
        style="@style/StoreFieldInput"
        android:hint="@string/hint_full_name"
        android:inputType="textPersonName|textCapWords" />

    <com.anokix.distributor.ui.views.RobotoBoldTextView
        style="@style/StoreFieldLabel"
        android:text="@string/contact_position" />

    <com.anokix.distributor.ui.views.RobotoEditText
        android:id="@+id/contactPosition"
        style="@style/StoreFieldInput"
        android:hint="@string/hint_position"
        android:inputType="textCapWords" />

    <com.anokix.distributor.ui.views.RobotoBoldTextView
        style="@style/StoreFieldLabel"
        android:text="@string/mobile_number" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_login_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp">

        <com.hbb20.CountryCodePicker
            android:id="@+id/contactCcp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            app:ccp_contentColor="@color/text_primary"
            app:ccp_defaultNameCode="ZA"
            app:ccp_showNameCode="false"
            app:ccp_textSize="14sp"
            app:ccpDialog_showTitle="true" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="@color/border" />

        <com.anokix.distributor.ui.views.RobotoEditText
            android:id="@+id/contactMobile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="82 123 4567"
            android:inputType="phone"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <com.anokix.distributor.ui.views.RobotoBoldTextView
        style="@style/StoreFieldLabel"
        android:text="@string/email_address_field" />

    <com.anokix.distributor.ui.views.RobotoEditText
        android:id="@+id/contactEmail"
        style="@style/StoreFieldInput"
        android:hint="@string/hint_email_address"
        android:inputType="textEmailAddress" />
</LinearLayout>
