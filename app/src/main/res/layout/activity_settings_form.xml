<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <include layout="@layout/include_secondary_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:contentPadding="16dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:id="@+id/sectionContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <com.anokix.distributor.ui.views.RobotoBoldTextView
            android:id="@+id/cancelButton"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:background="@drawable/bg_btn_back_pill"
            android:gravity="center"
            android:paddingHorizontal="22dp"
            android:text="@string/cancel_btn"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <com.anokix.distributor.ui.views.RobotoBoldTextView
            android:id="@+id/saveButton"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_btn_continue"
            android:gravity="center"
            android:minWidth="130dp"
            android:paddingHorizontal="22dp"
            android:text="@string/save_changes"
            android:textColor="@android:color/white"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
