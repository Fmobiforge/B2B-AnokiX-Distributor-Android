<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <include layout="@layout/include_logo_header" />

    <!--
      Title, KPI cards and the stock-mix donut scroll away as the list moves; the tabs,
      search and filter pills stay pinned so filtering is always one tap away.
    -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:stateListAnimator="@null"
            app:elevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface"
                android:orientation="vertical"
                app:layout_scrollFlags="scroll|enterAlways|snap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp">

                    <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/inventory_overview"
                        android:textAppearance="@style/TextAppearance.AnokiX.Headline" />

                    <com.anokix.distributorapp.ui.views.RobotoLightTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/inventory_subtitle"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <!-- ===== KPI cards ===== -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            style="@style/InventoryKpiCard"
                            android:layout_marginEnd="8dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <FrameLayout
                                    style="@style/InventoryKpiIconTile"
                                    android:background="@drawable/bg_kpi_icon_purple">

                                    <ImageView
                                        style="@style/InventoryKpiIcon"
                                        android:src="@drawable/ic_package"
                                        app:tint="@color/purple_primary" />
                                </FrameLayout>

                                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                                    style="@style/InventoryKpiTitle"
                                    android:text="@string/kpi_stock_value" />
                            </LinearLayout>

                            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                                android:id="@+id/kpiStockValue"
                                style="@style/InventoryKpiValue" />

                            <com.anokix.distributorapp.ui.views.RobotoTextView
                                style="@style/InventoryKpiCaption"
                                android:text="@string/kpi_stock_value_sub"
                                android:textColor="@color/success" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/InventoryKpiCard"
                            android:layout_marginEnd="8dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <FrameLayout
                                    style="@style/InventoryKpiIconTile"
                                    android:background="@drawable/bg_kpi_icon_green">

                                    <ImageView
                                        style="@style/InventoryKpiIcon"
                                        android:src="@drawable/ic_inventory"
                                        app:tint="@color/success" />
                                </FrameLayout>

                                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                                    style="@style/InventoryKpiTitle"
                                    android:text="@string/kpi_total_units" />
                            </LinearLayout>

                            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                                android:id="@+id/kpiTotalUnits"
                                style="@style/InventoryKpiValue" />

                            <com.anokix.distributorapp.ui.views.RobotoTextView
                                style="@style/InventoryKpiCaption"
                                android:text="@string/kpi_total_units_sub"
                                android:textColor="@color/success" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/InventoryKpiCard"
                            android:layout_marginEnd="8dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <FrameLayout
                                    style="@style/InventoryKpiIconTile"
                                    android:background="@drawable/bg_kpi_icon_orange">

                                    <ImageView
                                        style="@style/InventoryKpiIcon"
                                        android:src="@drawable/ic_warning_box"
                                        app:tint="@color/warning" />
                                </FrameLayout>

                                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                                    style="@style/InventoryKpiTitle"
                                    android:text="@string/kpi_low_stock_items" />
                            </LinearLayout>

                            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                                android:id="@+id/kpiLowStock"
                                style="@style/InventoryKpiValue" />

                            <com.anokix.distributorapp.ui.views.RobotoTextView
                                style="@style/InventoryKpiCaption"
                                android:text="@string/kpi_low_stock_sub"
                                android:textColor="@color/warning" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/InventoryKpiCard"
                            android:layout_marginEnd="8dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <FrameLayout
                                    style="@style/InventoryKpiIconTile"
                                    android:background="@drawable/bg_kpi_icon_red">

                                    <ImageView
                                        style="@style/InventoryKpiIcon"
                                        android:src="@drawable/ic_cancel_circle"
                                        app:tint="@color/danger" />
                                </FrameLayout>

                                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                                    style="@style/InventoryKpiTitle"
                                    android:text="@string/kpi_out_of_stock_items" />
                            </LinearLayout>

                            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                                android:id="@+id/kpiOutOfStock"
                                style="@style/InventoryKpiValue" />

                            <com.anokix.distributorapp.ui.views.RobotoTextView
                                style="@style/InventoryKpiCaption"
                                android:text="@string/kpi_out_of_stock_sub"
                                android:textColor="@color/danger" />
                        </LinearLayout>

                        <LinearLayout style="@style/InventoryKpiCard">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <FrameLayout
                                    style="@style/InventoryKpiIconTile"
                                    android:background="@drawable/bg_kpi_icon_blue">

                                    <ImageView
                                        style="@style/InventoryKpiIcon"
                                        android:src="@drawable/ic_finance_report"
                                        app:tint="@color/info" />
                                </FrameLayout>

                                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                                    style="@style/InventoryKpiTitle"
                                    android:text="@string/kpi_stock_movement" />
                            </LinearLayout>

                            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                                android:id="@+id/kpiMovements"
                                style="@style/InventoryKpiValue" />

                            <com.anokix.distributorapp.ui.views.RobotoTextView
                                style="@style/InventoryKpiCaption"
                                android:text="@string/kpi_stock_movement_sub"
                                android:textColor="@color/info" />
                        </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- ===== Stock mix donut ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_stat_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/inventory_summary_title"
                        android:textColor="@color/top_title"
                        android:textSize="@dimen/text_title" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.anokix.distributorapp.ui.views.DonutChartView
                            android:id="@+id/inventoryDonutChart"
                            android:layout_width="104dp"
                            android:layout_height="104dp" />

                        <LinearLayout
                            android:id="@+id/donutLegend"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface"
                android:orientation="vertical">

                <!-- ===== Stock tabs ===== -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/inventoryTabs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="10dp"
                    android:background="@color/border_light" />

                <!-- ===== Keyword search ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/search_bar_height"
                    android:layout_marginHorizontal="16dp"
                    android:background="@drawable/bg_search_bar"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search"
                        app:tint="@color/text_secondary" />

                    <com.anokix.distributorapp.ui.views.RobotoEditText
                        android:id="@+id/searchInput"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:gravity="center_vertical"
                        android:hint="@string/search_inventory"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingVertical="0dp"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="@dimen/text_body_sm" />
                </LinearLayout>

                <!-- ===== Category / brand filters ===== -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/categoryFilter"
                            style="@style/ProductFilterPill"
                            android:layout_marginEnd="8dp">

                            <com.anokix.distributorapp.ui.views.RobotoTextView
                                android:id="@+id/categoryFilterLabel"
                                style="@style/ProductFilterPillLabel"
                                android:text="@string/all_categories" />

                            <ImageView style="@style/ProductFilterPillChevron" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/brandFilter"
                            style="@style/ProductFilterPill">

                            <com.anokix.distributorapp.ui.views.RobotoTextView
                                android:id="@+id/brandFilterLabel"
                                style="@style/ProductFilterPillLabel"
                                android:text="@string/all_brands" />

                            <ImageView style="@style/ProductFilterPillChevron" />
                        </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border" />

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    android:id="@+id/inventoryCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/background"
                    android:paddingHorizontal="@dimen/screen_padding_horizontal"
                    android:paddingTop="10dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/inventoryList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/screen_padding_horizontal"
                android:paddingTop="@dimen/spacing_sm"
                android:paddingBottom="80dp" />

            <com.anokix.distributorapp.ui.views.RobotoTextView
                android:id="@+id/emptyView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:paddingHorizontal="32dp"
                android:text="@string/no_inventory_yet"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/addStockButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:background="@drawable/bg_login_button_primary"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_add"
                app:tint="#FFFFFF" />

            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/add_stock_receive"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</LinearLayout>
