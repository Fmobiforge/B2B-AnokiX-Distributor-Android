<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <include layout="@layout/include_logo_header" />

    <!--
      Only the tabs, search and filters stay put; the page title, KPI cards and donut
      ride in the list header (item_inventory_summary) so the stock cards always keep
      the remaining height and stay scrollable on short screens.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/inventoryTabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="10dp"
            android:background="@color/border_light" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/search_bar_height"
                android:layout_weight="1"
                android:background="@drawable/bg_search_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    app:tint="@color/text_secondary" />

                <com.anokix.distributorapp.ui.views.RobotoEditText
                    android:id="@+id/searchInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:hint="@string/search_inventory"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingVertical="0dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:textSize="@dimen/text_body_sm" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/categoryFilter"
                style="@style/ProductFilterPill"
                android:layout_marginStart="8dp"
                android:layout_height="@dimen/search_bar_height">

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    android:id="@+id/categoryFilterLabel"
                    style="@style/ProductFilterPillLabel"
                    android:maxWidth="88dp"
                    android:text="@string/all_categories" />

                <ImageView style="@style/ProductFilterPillChevron" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/brandFilter"
                style="@style/ProductFilterPill"
                android:layout_marginStart="8dp"
                android:layout_height="@dimen/search_bar_height">

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    android:id="@+id/brandFilterLabel"
                    style="@style/ProductFilterPillLabel"
                    android:maxWidth="76dp"
                    android:text="@string/all_brands" />

                <ImageView style="@style/ProductFilterPillChevron" />
            </LinearLayout>
        </LinearLayout>

        <com.anokix.distributorapp.ui.views.RobotoTextView
            android:id="@+id/inventoryCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="10dp"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/background">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/inventoryList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/spacing_md"
            android:paddingBottom="84dp" />

        <LinearLayout
            android:id="@+id/addStockButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:background="@drawable/bg_login_button_primary"
            android:elevation="4dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_add"
                app:tint="#FFFFFF" />

            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/add_stock_receive"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
