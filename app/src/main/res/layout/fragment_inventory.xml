<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <include layout="@layout/include_logo_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_lg">

            <!-- Page title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_padding_horizontal"
                android:paddingTop="@dimen/spacing_sm"
                android:paddingBottom="@dimen/spacing_xs">

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/inventory_overview"
                    android:textAppearance="@style/TextAppearance.AnokiX.Headline" />
            </LinearLayout>

            <!-- Summary stat cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/screen_padding_horizontal"
                android:paddingTop="@dimen/spacing_md"
                android:paddingBottom="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_card"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <com.anokix.distributorapp.ui.views.RobotoLightTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/total_skus"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_label" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="1,245"
                            android:textColor="@color/purple_primary"
                            android:textSize="@dimen/text_stat_value" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_inventory"
                            app:tint="@color/purple_primary" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_card"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <com.anokix.distributorapp.ui.views.RobotoLightTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/low_stock"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_label" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="86"
                            android:textColor="@color/warning"
                            android:textSize="@dimen/text_stat_value" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_warning_box"
                            app:tint="@color/warning" />
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_card"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <com.anokix.distributorapp.ui.views.RobotoLightTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/out_of_stock"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_label" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="12"
                            android:textColor="@color/danger"
                            android:textSize="@dimen/text_stat_value" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_cancel_circle"
                            app:tint="@color/danger" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <!-- Tabs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:paddingBottom="@dimen/spacing_xs">

                <LinearLayout
                    android:id="@+id/tabAllWrap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/spacing_xs">

                    <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                        android:id="@+id/tabAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingVertical="@dimen/spacing_sm"
                        android:text="@string/tab_all"
                        android:textColor="@color/purple_primary"
                        android:textSize="@dimen/text_body_sm" />

                    <View
                        android:id="@+id/tabAllIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginHorizontal="@dimen/spacing_md"
                        android:background="@drawable/bg_tab_indicator_purple" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabLowStockWrap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/spacing_xs">

                    <com.anokix.distributorapp.ui.views.RobotoTextView
                        android:id="@+id/tabLowStock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingVertical="@dimen/spacing_sm"
                        android:text="@string/low_stock"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body_sm" />

                    <View
                        android:id="@+id/tabLowStockIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginHorizontal="@dimen/spacing_md"
                        android:background="@drawable/bg_tab_indicator_purple"
                        android:visibility="invisible" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabExpiredWrap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/spacing_xs">

                    <com.anokix.distributorapp.ui.views.RobotoTextView
                        android:id="@+id/tabExpired"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingVertical="@dimen/spacing_sm"
                        android:text="@string/expired"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body_sm" />

                    <View
                        android:id="@+id/tabExpiredIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginHorizontal="@dimen/spacing_md"
                        android:background="@drawable/bg_tab_indicator_purple"
                        android:visibility="invisible" />
                </LinearLayout>
            </LinearLayout>

            <!-- Search & filter -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/screen_padding_horizontal"
                android:paddingBottom="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="@dimen/search_bar_height"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_bar"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_md">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search"
                        app:tint="@color/text_secondary" />

                    <com.anokix.distributorapp.ui.views.RobotoTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_weight="1"
                        android:text="@string/search_products_placeholder"
                        android:textAppearance="@style/TextAppearance.AnokiX.BodySecondary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/search_bar_height"
                    android:background="@drawable/bg_search_bar"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_md">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_filter"
                        app:tint="@color/text_secondary" />

                    <com.anokix.distributorapp.ui.views.RobotoTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:text="@string/filters"
                        android:textAppearance="@style/TextAppearance.AnokiX.BodySecondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Product table card: header + list -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding_horizontal"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Table header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/spacing_sm"
                        android:paddingBottom="@dimen/spacing_sm">

                        <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:text="@string/product_column"
                            android:textAppearance="@style/TextAppearance.AnokiX.Label"
                            android:textColor="@color/text_secondary" />

                        <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/sku_column"
                            android:textAppearance="@style/TextAppearance.AnokiX.Label"
                            android:textColor="@color/text_secondary" />

                        <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/stock_column"
                            android:textAppearance="@style/TextAppearance.AnokiX.Label"
                            android:textColor="@color/text_secondary" />

                        <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:gravity="end"
                            android:text="@string/status_column"
                            android:textAppearance="@style/TextAppearance.AnokiX.Label"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/inventoryList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:paddingBottom="@dimen/spacing_xs"
                        tools:listitem="@layout/item_inventory" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Inventory Summary -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding_horizontal"
                android:layout_marginTop="@dimen/spacing_md"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/inventory_summary"
                        android:textAppearance="@style/TextAppearance.AnokiX.Title" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="120dp"
                            android:layout_height="120dp">

                            <com.anokix.distributorapp.ui.views.DonutChartView
                                android:id="@+id/inventoryDonutChart"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:orientation="vertical">

                                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="1,245"
                                    android:textColor="@color/text_primary"
                                    android:textSize="@dimen/text_title" />

                                <com.anokix.distributorapp.ui.views.RobotoLightTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/total_skus"
                                    android:textAppearance="@style/TextAppearance.AnokiX.Micro" />
                            </LinearLayout>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_lg"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingVertical="@dimen/spacing_xs">

                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/bg_badge_success" />

                                <com.anokix.distributorapp.ui.views.RobotoTextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/spacing_sm"
                                    android:layout_weight="1"
                                    android:text="@string/in_stock"
                                    android:textAppearance="@style/TextAppearance.AnokiX.Caption" />

                                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="1,047 (84%)"
                                    android:textAppearance="@style/TextAppearance.AnokiX.Caption"
                                    android:textColor="@color/text_primary" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingVertical="@dimen/spacing_xs">

                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/bg_badge_warning" />

                                <com.anokix.distributorapp.ui.views.RobotoTextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/spacing_sm"
                                    android:layout_weight="1"
                                    android:text="@string/low_stock"
                                    android:textAppearance="@style/TextAppearance.AnokiX.Caption" />

                                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="86 (7%)"
                                    android:textAppearance="@style/TextAppearance.AnokiX.Caption"
                                    android:textColor="@color/text_primary" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingVertical="@dimen/spacing_xs">

                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/bg_badge_danger" />

                                <com.anokix.distributorapp.ui.views.RobotoTextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/spacing_sm"
                                    android:layout_weight="1"
                                    android:text="@string/out_of_stock"
                                    android:textAppearance="@style/TextAppearance.AnokiX.Caption" />

                                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="12 (1%)"
                                    android:textAppearance="@style/TextAppearance.AnokiX.Caption"
                                    android:textColor="@color/text_primary" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
