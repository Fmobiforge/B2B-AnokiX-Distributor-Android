<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/purple_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_chevron_right"
            android:rotation="180"
            app:tint="@android:color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_new_trader"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <com.anokix.distributorapp.ui.views.RobotoTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/create_trader_subtitle"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <!-- Stepper (populated in code) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/stepperContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp" />
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <!-- Steps -->
    <ViewFlipper
        android:id="@+id/stepFlipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface">

        <!-- ============ STEP 1: OWNER ============ -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp">

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/owner_information"
                    android:textAppearance="@style/TextAppearance.AnokiX.Title"
                    android:textColor="@color/top_title" />

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/owner_information_sub"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/owner_first_name" />

                <com.anokix.distributorapp.ui.views.RobotoEditText
                    android:id="@+id/etFirstName"
                    style="@style/StoreFieldInput"
                    android:hint="@string/hint_first_name"
                    android:inputType="textPersonName|textCapWords" />

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/owner_last_name" />

                <com.anokix.distributorapp.ui.views.RobotoEditText
                    android:id="@+id/etLastName"
                    style="@style/StoreFieldInput"
                    android:hint="@string/hint_last_name"
                    android:inputType="textPersonName|textCapWords" />

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/id_number" />

                <com.anokix.distributorapp.ui.views.RobotoEditText
                    android:id="@+id/etIdNumber"
                    style="@style/StoreFieldInput"
                    android:hint="@string/hint_id_number"
                    android:inputType="number" />

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/passport_number" />

                <com.anokix.distributorapp.ui.views.RobotoEditText
                    android:id="@+id/etPassportNumber"
                    style="@style/StoreFieldInput"
                    android:hint="@string/hint_passport_number"
                    android:inputType="textCapCharacters" />

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/id_or_passport_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <!-- Owner contact info box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_info_box"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/owner_contact"
                        android:textColor="@color/info"
                        android:textSize="13sp" />

                    <com.anokix.distributorapp.ui.views.RobotoTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/owner_contact_sub"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/mobile_number" />

                <!-- Mobile with country picker (CCP) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_login_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp">

                    <com.hbb20.CountryCodePicker
                        android:id="@+id/ccpOwner"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        app:ccp_contentColor="@color/text_primary"
                        app:ccp_defaultNameCode="ZA"
                        app:ccp_showNameCode="false"
                        app:ccp_textSize="14sp"
                        android:gravity="center"
                        app:ccpDialog_showTitle="true" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="@color/border" />

                    <com.anokix.distributorapp.ui.views.RobotoEditText
                        android:id="@+id/etOwnerMobile"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="82 123 4567"
                        android:inputType="phone"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/email_address_field" />

                <com.anokix.distributorapp.ui.views.RobotoEditText
                    android:id="@+id/etOwnerEmail"
                    style="@style/StoreFieldInput"
                    android:hint="@string/hint_email_address"
                    android:inputType="textEmailAddress" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ============ STEP 2: BUSINESS ============ -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp">

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/business_information"
                    android:textColor="@color/top_title"
                    android:textAppearance="@style/TextAppearance.AnokiX.Title" />

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/business_information_sub"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/business_name" />

                <com.anokix.distributorapp.ui.views.RobotoEditText
                    android:id="@+id/etBusinessName"
                    style="@style/StoreFieldInput"
                    android:hint="@string/hint_business_name"
                    android:inputType="textCapWords" />

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/trading_name" />

                <com.anokix.distributorapp.ui.views.RobotoEditText
                    android:id="@+id/etTradingName"
                    style="@style/StoreFieldInput"
                    android:hint="@string/hint_trading_name"
                    android:inputType="textCapWords" />

                <LinearLayout
                    style="@style/StoreFieldLabel"
                    android:orientation="horizontal">

                    <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/business_registration_number"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <com.anokix.distributorapp.ui.views.RobotoTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/optional_label"
                        android:textColor="@color/text_tertiary"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.anokix.distributorapp.ui.views.RobotoEditText
                    android:id="@+id/etBusinessReg"
                    style="@style/StoreFieldInput"
                    android:hint="@string/hint_business_reg"
                    android:inputType="text" />

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/business_phone_number" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_login_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp">

                    <com.hbb20.CountryCodePicker
                        android:id="@+id/ccpBusiness"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        app:ccp_contentColor="@color/text_primary"
                        app:ccp_defaultNameCode="ZA"
                        app:ccp_showNameCode="false"
                        android:gravity="center"
                        app:ccp_textSize="14sp"
                        app:ccpDialog_showTitle="true" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="@color/border" />

                    <com.anokix.distributorapp.ui.views.RobotoEditText
                        android:id="@+id/etBusinessPhone"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="24 364 777"
                        android:inputType="phone"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/business_email_address" />

                <com.anokix.distributorapp.ui.views.RobotoEditText
                    android:id="@+id/etBusinessEmail"
                    style="@style/StoreFieldInput"
                    android:hint="@string/hint_business_email"
                    android:inputType="textEmailAddress" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ============ STEP 3: TRADER ============ -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp">

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/trader_classification"
                    android:textColor="@color/top_title"
                    android:textAppearance="@style/TextAppearance.AnokiX.Title" />

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/trader_classification_sub"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <!-- Trader type cards (populated in code) -->
                <com.anokix.distributorapp.ui.views.FlowLayout
                    android:id="@+id/traderTypeContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" />

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/primary_product_categories"
                    android:textColor="@color/top_title"
                    android:textSize="18sp" />

                <!-- Category multi-select field -->
                <LinearLayout
                    android:id="@+id/categoryField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_login_input"
                    android:minHeight="48dp"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <com.anokix.distributorapp.ui.views.RobotoTextView
                        android:id="@+id/categoryHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        android:text="@string/select_categories_hint"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <com.anokix.distributorapp.ui.views.FlowLayout
                        android:id="@+id/categoryChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ============ STEP 4: LOCATION ============ -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/step4Scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp">

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/business_location"
                    android:textColor="@color/top_title"
                    android:textAppearance="@style/TextAppearance.AnokiX.Title" />

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/business_location_sub"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/address_of_business" />

                <com.anokix.distributorapp.ui.views.RobotoEditText
                    android:id="@+id/etAddressSearch"
                    style="@style/StoreFieldInput"
                    android:hint="@string/search_address_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text" />

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/map_pin_hint_trader"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <com.google.android.gms.maps.MapView
                    android:id="@+id/traderMap"
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ============ STEP 5: VERIFY ============ -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp">

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/business_verification"
                    android:textColor="@color/top_title"
                    android:textAppearance="@style/TextAppearance.AnokiX.Title" />

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="14dp"
                    android:text="@string/business_verification_sub"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/documentContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/accepted_formats"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ============ STEP 6: DISTRIBUTOR ============ -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp">

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_preferred_distributor"
                    android:textColor="@color/top_title"
                    android:textAppearance="@style/TextAppearance.AnokiX.Title" />

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/select_preferred_distributor_sub"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/preferred_distributors"
                    android:textColor="@color/top_title"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/distributorField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_login_input"
                    android:minHeight="48dp"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <com.anokix.distributorapp.ui.views.RobotoTextView
                        android:id="@+id/distributorHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        android:text="@string/select_distributors_hint"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <com.anokix.distributorapp.ui.views.FlowLayout
                        android:id="@+id/distributorChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/preferred_delivery_days" />

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/select_all_apply"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp" />

                <com.anokix.distributorapp.ui.views.FlowLayout
                    android:id="@+id/deliveryDaysContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    style="@style/StoreFieldLabel"
                    android:text="@string/preferred_payment_method" />

                <LinearLayout
                    android:id="@+id/paymentMethodField"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_login_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <com.anokix.distributorapp.ui.views.RobotoTextView
                        android:id="@+id/paymentMethodLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/select_payment_method"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:rotation="90"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ============ STEP 7: WALLET ============ -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp">

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/activate_merchant_wallet"
                    android:textColor="@color/top_title"
                    android:textAppearance="@style/TextAppearance.AnokiX.Title" />

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/powered_by_imb"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <FrameLayout
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_wallet_icon">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_wallet"
                        app:tint="@android:color/white" />
                </FrameLayout>

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/benefits"
                    android:textColor="@color/top_title"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/benefitsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <!-- Wallet choice -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_wallet_panel"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <LinearLayout
                        android:id="@+id/optionCreateWallet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/radioCreateWallet"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_radio_selected" />

                        <com.anokix.distributorapp.ui.views.RobotoTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="@string/create_wallet_now"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/optionActivateLater"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/radioActivateLater"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_radio_unselected" />

                        <com.anokix.distributorapp.ui.views.RobotoTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="@string/activate_later"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ============ STEP 8: TERMS ============ -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp">

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/terms_conditions"
                    android:textColor="@color/top_title"
                    android:textAppearance="@style/TextAppearance.AnokiX.Title" />

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/terms_conditions_sub"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cbAccurate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingStart="8dp"
                    android:text="@string/terms_accurate"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cbTos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingStart="8dp"
                    android:text="@string/terms_tos"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cbKyc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingStart="8dp"
                    android:text="@string/terms_kyc"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cbComms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingStart="8dp"
                    android:text="@string/terms_comms"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </ViewFlipper>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <!-- Bottom navigation bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <com.anokix.distributorapp.ui.views.RobotoBoldTextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:background="@drawable/bg_btn_back_pill"
            android:gravity="center"
            android:paddingHorizontal="22dp"
            android:text="@string/back_btn"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.anokix.distributorapp.ui.views.RobotoBoldTextView
            android:id="@+id/btnContinue"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:background="@drawable/bg_btn_continue"
            android:gravity="center"
            android:minWidth="130dp"
            android:paddingHorizontal="26dp"
            android:text="@string/continue_btn"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

    </LinearLayout>
</LinearLayout>
