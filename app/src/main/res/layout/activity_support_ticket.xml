<?xml version="1.0" encoding="utf-8"?>
<!--
  One support ticket (New-Design/Support Centre/4.Open-Ticket.png, 5.Closed-Ticket.png).

  The conversation reads as a chat thread: our messages on the right, support on the
  left, and status notes centred. The composer is pinned to the bottom above the
  keyboard while the ticket is open; a closed ticket replaces it with the closing notice.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <include layout="@layout/include_secondary_header" />

    <!-- Status strip: badge + when the ticket was opened. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <com.anokix.distributorapp.ui.views.RobotoTextView
            android:id="@+id/ticketStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textSize="@dimen/text_micro" />

        <com.anokix.distributorapp.ui.views.RobotoTextView
            android:id="@+id/ticketOpened"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <com.anokix.distributorapp.ui.views.RobotoTextView
            android:id="@+id/ticketPriority"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textSize="@dimen/text_micro"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messagesList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/background"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp" />

    <!-- Composer (open tickets) -->
    <LinearLayout
        android:id="@+id/composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="10dp"
            android:background="@color/border" />

        <com.anokix.distributorapp.ui.views.RobotoEditText
            android:id="@+id/replyInput"
            style="@style/StoreFieldInput"
            android:layout_height="84dp"
            android:gravity="top|start"
            android:hint="@string/ticket_reply_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:paddingVertical="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                android:id="@+id/closeTicketButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_login_button_outlined"
                android:gravity="center"
                android:text="@string/ticket_close"
                android:textColor="@color/purple_primary"
                android:textSize="14sp" />

            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                android:id="@+id/sendReplyButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_login_button_primary"
                android:gravity="center"
                android:text="@string/ticket_send_reply"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Closed notice (5.Closed-Ticket.png) -->
    <com.anokix.distributorapp.ui.views.RobotoTextView
        android:id="@+id/closedNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:drawableStart="@drawable/ic_check_circle"
        android:drawablePadding="8dp"
        android:drawableTint="@color/text_secondary"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp"
        android:text="@string/ticket_closed_notice"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
