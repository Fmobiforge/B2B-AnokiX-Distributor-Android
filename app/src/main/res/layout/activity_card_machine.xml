<?xml version="1.0" encoding="utf-8"?>
<!-- Card Machine (New-Design/Card-Machine/1.Card-Machine-Dashboard.png): take a payment,
     manage the linked PayCloud machines, and review what has been pushed to them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <include layout="@layout/include_secondary_header" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/cardMachineScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== Take a card payment ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stat_card"
                android:orientation="vertical"
                android:padding="16dp">

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pos_take_payment"
                    android:textColor="@color/top_title"
                    android:textSize="@dimen/text_display" />

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/pos_take_payment_sub"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <!-- Shown until a machine is linked -->
                <LinearLayout
                    android:id="@+id/noMachineBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_info_box"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/info" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                            android:id="@+id/bannerTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pos_no_machine_title"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_body" />

                        <com.anokix.distributorapp.ui.views.RobotoTextView
                            android:id="@+id/bannerBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/pos_no_machine_body"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Payment form -->
                <LinearLayout
                    android:id="@+id/paymentForm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.anokix.distributorapp.ui.views.RobotoTextView
                        style="@style/StoreFieldLabel"
                        android:text="@string/pos_amount" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/bg_login_input"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/currency_symbol"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_title" />

                        <com.anokix.distributorapp.ui.views.RobotoEditText
                            android:id="@+id/amountInput"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:gravity="center_vertical"
                            android:hint="@string/pos_amount_hint"
                            android:inputType="numberDecimal"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="@dimen/text_title" />
                    </LinearLayout>

                    <com.anokix.distributorapp.ui.views.RobotoTextView
                        style="@style/StoreFieldLabel"
                        android:text="@string/pos_card_machine" />

                    <LinearLayout
                        android:id="@+id/terminalField"
                        style="@style/ProductDropdown"
                        android:layout_height="48dp">

                        <com.anokix.distributorapp.ui.views.RobotoTextView
                            android:id="@+id/terminalLabel"
                            style="@style/ProductDropdownLabel"
                            android:text="@string/pos_select_machine" />

                        <ImageView style="@style/ProductDropdownChevron" />
                    </LinearLayout>

                    <com.anokix.distributorapp.ui.views.RobotoTextView
                        style="@style/StoreFieldLabel"
                        android:text="@string/pos_reference" />

                    <com.anokix.distributorapp.ui.views.RobotoEditText
                        android:id="@+id/referenceInput"
                        style="@style/StoreFieldInput"
                        android:layout_height="48dp"
                        android:hint="@string/pos_reference_hint"
                        android:inputType="textCapSentences"
                        android:maxLines="1" />

                    <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                        android:id="@+id/sendButton"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_login_button_primary"
                        android:drawablePadding="8dp"
                        android:gravity="center"
                        android:text="@string/pos_send_to_machine"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        app:drawableStartCompat="@drawable/ic_card" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Your card machines ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_stat_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pos_your_machines"
                        android:textColor="@color/top_title"
                        android:textSize="@dimen/text_display" />

                    <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                        android:id="@+id/addMachineButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_login_button_outlined"
                        android:drawablePadding="6dp"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="@string/pos_add_machine"
                        android:textColor="@color/purple_primary"
                        android:textSize="@dimen/text_body_sm"
                        app:drawableStartCompat="@drawable/ic_add"
                        app:drawableTint="@color/purple_primary" />
                </LinearLayout>

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/pos_machines_sub"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <LinearLayout
                    android:id="@+id/machineList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    android:id="@+id/machinesEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center"
                    android:text="@string/pos_no_machines"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_body"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ===== Card machine payments ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_stat_card"
                android:orientation="vertical"
                android:padding="16dp">

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pos_payments"
                    android:textColor="@color/top_title"
                    android:textSize="@dimen/text_display" />

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/pos_payments_sub"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <LinearLayout
                    android:id="@+id/paymentList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/paymentsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_empty_inbox" />

                    <com.anokix.distributorapp.ui.views.RobotoTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="@string/pos_no_payments"
                        android:textColor="@color/text_tertiary"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>

                <!-- Pagination -->
                <LinearLayout
                    android:id="@+id/paginationBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.anokix.distributorapp.ui.views.RobotoTextView
                        android:id="@+id/paginationLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />

                    <ImageButton
                        android:id="@+id/prevPage"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_icon_button_circle"
                        android:contentDescription="@string/pos_previous_page"
                        android:padding="9dp"
                        android:rotation="180"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_secondary" />

                    <ImageButton
                        android:id="@+id/nextPage"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_icon_button_circle"
                        android:contentDescription="@string/pos_next_page"
                        android:padding="9dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
