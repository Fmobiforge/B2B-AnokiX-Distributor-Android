<?xml version="1.0" encoding="utf-8"?>
<!-- Card Machine (New-Design/Card-Machine/1.Card-Machine-Dashboard.png). The payment
     panel borrows the anokiX wallet's purple hero so the two money screens match. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <include layout="@layout/include_secondary_header" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/cardMachineScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="24dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===================== Payment hero ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_wallet_balance_card"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.anokix.distributorapp.ui.views.RobotoTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:alpha="0.9"
                        android:text="@string/pos_take_payment"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_body_sm" />

                    <!-- Machine picker -->
                    <LinearLayout
                        android:id="@+id/terminalField"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_wallet_glass"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_card"
                            app:tint="@color/white" />

                        <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                            android:id="@+id/terminalLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:maxWidth="120dp"
                            android:text="@string/pos_select_machine"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_caption" />

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginStart="6dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="@color/white" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Amount -->
                <LinearLayout
                    android:id="@+id/amountRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:baselineAligned="false"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:alpha="0.75"
                        android:text="@string/currency_symbol"
                        android:textColor="@color/white"
                        android:textSize="22sp" />

                    <com.anokix.distributorapp.ui.views.RobotoEditText
                        android:id="@+id/amountInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/pos_amount_hint"
                        android:inputType="numberDecimal"
                        android:letterSpacing="-0.02"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textColorHint="#80FFFFFF"
                        android:textSize="34sp" />
                </LinearLayout>

                <View
                    android:id="@+id/amountUnderline"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_wallet_divider_light" />

                <!-- Quick amounts -->
                <HorizontalScrollView
                    android:id="@+id/quickAmountScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipToPadding="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/quickAmounts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- Reference -->
                <com.anokix.distributorapp.ui.views.RobotoEditText
                    android:id="@+id/referenceInput"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_pos_glass_input"
                    android:gravity="center_vertical"
                    android:hint="@string/pos_reference_hint"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/white"
                    android:textColorHint="#99FFFFFF"
                    android:textSize="@dimen/text_body" />

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:id="@+id/sendButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_wallet_white_button"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:text="@string/pos_send_to_machine"
                    android:textColor="@color/purple_dark"
                    android:textSize="15sp"
                    app:drawableStartCompat="@drawable/ic_card"
                    app:drawableTint="@color/purple_dark" />

                <!-- Shown until a machine is linked -->
                <LinearLayout
                    android:id="@+id/noMachineBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_pos_glass_input"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/white" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                            android:id="@+id/bannerTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pos_no_machine_title"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_body" />

                        <com.anokix.distributorapp.ui.views.RobotoTextView
                            android:id="@+id/bannerBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.85"
                            android:text="@string/pos_no_machine_body"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:alpha="0.75"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_shield_check"
                        app:tint="@color/white" />

                    <com.anokix.distributorapp.ui.views.RobotoTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:alpha="0.75"
                        android:text="@string/pos_secure_note"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_micro" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===================== Machines ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_stat_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_kpi_icon_purple">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_card"
                            app:tint="@color/purple_primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pos_your_machines"
                            android:textColor="@color/top_title"
                            android:textSize="@dimen/text_title" />

                        <com.anokix.distributorapp.ui.views.RobotoTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="@string/pos_machines_sub"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_micro" />
                    </LinearLayout>

                    <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                        android:id="@+id/addMachineButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_login_button_outlined"
                        android:drawablePadding="4dp"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="@string/pos_add"
                        android:textColor="@color/purple_primary"
                        android:textSize="@dimen/text_body_sm"
                        app:drawableStartCompat="@drawable/ic_add"
                        app:drawableTint="@color/purple_primary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/machineList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    android:id="@+id/machinesEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="6dp"
                    android:gravity="center"
                    android:text="@string/pos_no_machines"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_body_sm"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ===================== Payments ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_stat_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_kpi_icon_blue">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_receipt"
                            app:tint="@color/info" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pos_payments"
                            android:textColor="@color/top_title"
                            android:textSize="@dimen/text_title" />

                        <com.anokix.distributorapp.ui.views.RobotoTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="@string/pos_payments_sub"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_micro" />
                    </LinearLayout>

                    <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                        android:id="@+id/paymentCountChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_purple"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/purple_primary"
                        android:textSize="@dimen/text_micro"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/paymentList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/paymentsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_empty_inbox" />

                    <com.anokix.distributorapp.ui.views.RobotoTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="@string/pos_no_payments"
                        android:textColor="@color/text_tertiary"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/paginationBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.anokix.distributorapp.ui.views.RobotoTextView
                        android:id="@+id/paginationLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />

                    <ImageButton
                        android:id="@+id/prevPage"
                        style="@style/InventoryIconButton"
                        android:contentDescription="@string/pos_previous_page"
                        android:rotation="180"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_secondary" />

                    <ImageButton
                        android:id="@+id/nextPage"
                        style="@style/InventoryIconButton"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/pos_next_page"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
