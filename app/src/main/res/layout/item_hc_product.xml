<?xml version="1.0" encoding="utf-8"?>
<!-- Hirt & Carter library card: square image, BRAND, name, size + GTIN, tags. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="5dp">

    <FrameLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hc_card"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <LinearLayout
            android:id="@+id/cardContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <FrameLayout
                    android:id="@+id/thumbWell"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/bg_hc_thumb_well"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/thumb"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/surface"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter" />

                    <ImageView
                        android:id="@+id/thumbPlaceholder"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_image_placeholder"
                        android:visibility="gone" />
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                android:id="@+id/brand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.1"
                android:lines="2"
                android:maxLines="2"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    android:id="@+id/size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/gtin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.anokix.distributorapp.ui.views.RobotoTextView
                android:id="@+id/tagNoImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_hc_tag_muted"
                android:paddingHorizontal="7dp"
                android:paddingVertical="1dp"
                android:text="@string/hc_tag_no_image"
                android:textColor="@color/hc_slate"
                android:textSize="11sp"
                android:visibility="gone" />

            <com.anokix.distributorapp.ui.views.RobotoTextView
                android:id="@+id/tagAdded"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_hc_tag_purple"
                android:paddingHorizontal="7dp"
                android:paddingVertical="1dp"
                android:text="@string/hc_tag_added"
                android:textColor="@color/hc_tag_purple"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Shown on the card whose details are being fetched -->
        <FrameLayout
            android:id="@+id/busyOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_hc_overlay"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/hc_violet" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
