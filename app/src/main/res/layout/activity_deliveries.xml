<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <include layout="@layout/include_secondary_header" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp">

            <!-- ===== Summary stats (horizontal scroll) ===== -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Total -->
                    <LinearLayout
                        style="@style/DeliveryStatCard"
                        android:layout_marginEnd="10dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_kpi_icon_purple">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_shopping_bag"
                                app:tint="@color/purple_primary" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:orientation="vertical">

                            <com.anokix.distributor.ui.views.RobotoTextView
                                style="@style/DeliveryStatLabel"
                                android:text="@string/total_deliveries" />

                            <com.anokix.distributor.ui.views.RobotoBoldTextView
                                android:id="@+id/valTotalDeliveries"
                                style="@style/DeliveryStatValue"
                                android:text="0" />

                            <com.anokix.distributor.ui.views.RobotoLightTextView
                                style="@style/DeliveryStatSub"
                                android:text="@string/in_selected_range" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- On Time -->
                    <LinearLayout
                        style="@style/DeliveryStatCard"
                        android:layout_marginEnd="10dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_kpi_icon_green">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_check_circle"
                                app:tint="@color/success" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical">

                            <com.anokix.distributor.ui.views.RobotoTextView
                                style="@style/DeliveryStatLabel"
                                android:text="@string/on_time" />

                            <com.anokix.distributor.ui.views.RobotoBoldTextView
                                android:id="@+id/valOnTime"
                                style="@style/DeliveryStatValue"
                                android:text="0" />

                            <com.anokix.distributor.ui.views.RobotoLightTextView
                                android:id="@+id/subOnTime"
                                style="@style/DeliveryStatSub"
                                android:text="0%"
                                android:textColor="@color/success" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- In Transit -->
                    <LinearLayout
                        style="@style/DeliveryStatCard"
                        android:layout_marginEnd="10dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_kpi_icon_blue">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_deliveries"
                                app:tint="@color/info" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical">

                            <com.anokix.distributor.ui.views.RobotoTextView
                                style="@style/DeliveryStatLabel"
                                android:text="@string/in_transit" />

                            <com.anokix.distributor.ui.views.RobotoBoldTextView
                                android:id="@+id/valInTransit"
                                style="@style/DeliveryStatValue"
                                android:text="0" />

                            <com.anokix.distributor.ui.views.RobotoLightTextView
                                android:id="@+id/subInTransit"
                                style="@style/DeliveryStatSub"
                                android:text="0%"
                                android:textColor="@color/info" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Delayed -->
                    <LinearLayout
                        style="@style/DeliveryStatCard"
                        android:layout_marginEnd="10dp">

                        <FrameLayout
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_kpi_icon_orange">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_clock"
                                app:tint="@color/warning" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical">

                            <com.anokix.distributor.ui.views.RobotoTextView
                                style="@style/DeliveryStatLabel"
                                android:text="@string/delayed" />

                            <com.anokix.distributor.ui.views.RobotoBoldTextView
                                android:id="@+id/valDelayed"
                                style="@style/DeliveryStatValue"
                                android:text="0" />

                            <com.anokix.distributor.ui.views.RobotoLightTextView
                                android:id="@+id/subDelayed"
                                style="@style/DeliveryStatSub"
                                android:text="0%"
                                android:textColor="@color/warning" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Failed -->
                    <LinearLayout style="@style/DeliveryStatCard">

                        <FrameLayout
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_kpi_icon_red">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_close"
                                app:tint="@color/danger" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical">

                            <com.anokix.distributor.ui.views.RobotoTextView
                                style="@style/DeliveryStatLabel"
                                android:text="@string/failed_status" />

                            <com.anokix.distributor.ui.views.RobotoBoldTextView
                                android:id="@+id/valFailed"
                                style="@style/DeliveryStatValue"
                                android:text="0" />

                            <com.anokix.distributor.ui.views.RobotoLightTextView
                                android:id="@+id/subFailed"
                                style="@style/DeliveryStatSub"
                                android:text="0%"
                                android:textColor="@color/danger" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- ===== Search ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_search_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    app:tint="@color/text_secondary" />

                <com.anokix.distributor.ui.views.RobotoEditText
                    android:id="@+id/searchInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:hint="@string/search_deliveries"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingVertical="0dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- ===== Filters: Area + Date range ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/areaFilter"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/filter_pill_height"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_bar"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_location_pin"
                        app:tint="@color/text_secondary" />

                    <com.anokix.distributor.ui.views.RobotoTextView
                        android:id="@+id/areaFilterLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/all_areas"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:rotation="90"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dateRangeButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/filter_pill_height"
                    android:layout_weight="1.4"
                    android:background="@drawable/bg_search_bar"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/text_secondary" />

                    <com.anokix.distributor.ui.views.RobotoTextView
                        android:id="@+id/dateRangeLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="31 Mar – 30 Jun 2026"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Status tabs ===== -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_segment_container"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <com.anokix.distributor.ui.views.RobotoBoldTextView
                        android:id="@+id/tabAll"
                        style="@style/DeliveryTab"
                        android:background="@drawable/bg_segment_tab_selected"
                        android:text="@string/tab_all"
                        android:textColor="#FFFFFF" />

                    <com.anokix.distributor.ui.views.RobotoTextView
                        android:id="@+id/tabInTransit"
                        style="@style/DeliveryTab"
                        android:text="@string/in_transit" />

                    <com.anokix.distributor.ui.views.RobotoTextView
                        android:id="@+id/tabDelivered"
                        style="@style/DeliveryTab"
                        android:text="@string/delivered" />

                    <com.anokix.distributor.ui.views.RobotoTextView
                        android:id="@+id/tabDelayed"
                        style="@style/DeliveryTab"
                        android:text="@string/delayed" />

                    <com.anokix.distributor.ui.views.RobotoTextView
                        android:id="@+id/tabFailed"
                        style="@style/DeliveryTab"
                        android:text="@string/failed_status" />

                    <com.anokix.distributor.ui.views.RobotoTextView
                        android:id="@+id/tabReturned"
                        style="@style/DeliveryTab"
                        android:text="@string/returned_status" />
                </LinearLayout>
            </HorizontalScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/deliveriesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="14dp"
                android:nestedScrollingEnabled="false" />

            <com.anokix.distributor.ui.views.RobotoTextView
                android:id="@+id/emptyView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:gravity="center"
                android:text="@string/no_deliveries"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="48dp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
