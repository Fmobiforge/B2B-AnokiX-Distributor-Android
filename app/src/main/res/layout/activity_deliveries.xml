<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <include layout="@layout/include_secondary_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <com.anokix.distributor.ui.views.RobotoBoldTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/deliveries"
            android:textAppearance="@style/TextAppearance.AnokiX.Headline" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_segment_container"
            android:orientation="horizontal"
            android:padding="4dp">

            <com.anokix.distributor.ui.views.RobotoBoldTextView
                android:id="@+id/tabAll"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_segment_tab_selected"
                android:gravity="center"
                android:minWidth="72dp"
                android:paddingHorizontal="14dp"
                android:text="@string/tab_all"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <com.anokix.distributor.ui.views.RobotoTextView
                android:id="@+id/tabInTransit"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:minWidth="88dp"
                android:paddingHorizontal="14dp"
                android:text="@string/in_transit"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <com.anokix.distributor.ui.views.RobotoTextView
                android:id="@+id/tabDelivered"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:minWidth="88dp"
                android:paddingHorizontal="14dp"
                android:text="@string/delivered"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <com.anokix.distributor.ui.views.RobotoTextView
                android:id="@+id/tabDelayed"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:minWidth="80dp"
                android:paddingHorizontal="14dp"
                android:text="@string/delayed"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/dateRangeButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/filter_pill_height"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_date_pill"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_calendar"
                app:tint="@color/text_secondary" />

            <com.anokix.distributor.ui.views.RobotoTextView
                android:id="@+id/dateRangeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="20 May – 26 May 2025"
                android:textAppearance="@style/TextAppearance.AnokiX.Caption"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/driverFilterButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/filter_pill_height"
            android:background="@drawable/bg_date_pill"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_person"
                app:tint="@color/text_secondary" />

            <com.anokix.distributor.ui.views.RobotoTextView
                android:id="@+id/driverFilterLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/driver_label"
                android:textAppearance="@style/TextAppearance.AnokiX.Caption"
                android:textColor="@color/text_primary" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@null"
                android:rotation="90"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/deliveriesList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp" />
</LinearLayout>
