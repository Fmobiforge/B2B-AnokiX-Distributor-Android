<?xml version="1.0" encoding="utf-8"?>
<!-- One offer card inside "Loan Offers for You". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_stat_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_wallet_action_tile">

            <ImageView
                android:id="@+id/loanIcon"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                app:tint="@color/purple_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                android:id="@+id/loanTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_title" />

            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                android:id="@+id/loanBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_badge_recommended"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@color/purple_primary"
                android:textSize="@dimen/text_label"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.anokix.distributorapp.ui.views.RobotoTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wallet_loan_amount"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption" />

            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                android:id="@+id/loanAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.anokix.distributorapp.ui.views.RobotoTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wallet_interest_rate"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption" />

            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                android:id="@+id/loanRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" />
        </LinearLayout>
    </LinearLayout>

    <com.anokix.distributorapp.ui.views.RobotoBoldTextView
        android:id="@+id/loanApply"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_outlined_button_purple"
        android:gravity="center"
        android:text="@string/wallet_apply_now"
        android:textColor="@color/purple_primary"
        android:textSize="@dimen/text_body" />
</LinearLayout>
