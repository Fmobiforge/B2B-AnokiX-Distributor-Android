<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:contentPadding="0dp"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Trader + amount/status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                android:id="@+id/avatarText"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_avatar"
                android:gravity="center"
                android:text="UL"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:id="@+id/traderName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Urban Food Market (Pty) Ltd"
                    android:textColor="@color/top_title"
                    android:textSize="14sp" />

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:id="@+id/orderId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="ORD000012"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    android:id="@+id/orderTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="24 Jun 2026, 20:47"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:layout_marginStart="3dp"
                android:orientation="vertical">

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:id="@+id/orderAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R400,00"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:id="@+id/statusRibbon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_badge_warning"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="Order Queue"
                    android:textColor="@color/warning"
                    android:textSize="10sp" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Products -->
            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                android:id="@+id/productsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="PRODUCTS 1"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <com.anokix.distributorapp.ui.views.RobotoTextView
                android:id="@+id/deliveryInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginStart="@dimen/padding1"
                android:gravity="end"
                android:ellipsize="end"
                android:text="25 Jun, 08:00–22:00"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/productChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:chipSpacingVertical="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/divider" />

        <!-- Actions -->
        <LinearLayout
            android:id="@+id/orderActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/btnViewOrder"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_btn_view_order"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_eye"
                    app:tint="@color/text_primary" />

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/view_order"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnPrimaryAction"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_approve_outline"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/primaryActionIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/success" />

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:id="@+id/primaryActionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/order_action_accept"
                    android:textColor="@color/success"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnRejectAction"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_reject_outline"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_cancel_circle"
                    app:tint="@color/danger" />

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/order_action_reject"
                    android:textColor="@color/danger"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
