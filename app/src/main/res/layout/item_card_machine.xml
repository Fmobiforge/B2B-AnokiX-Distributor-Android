<?xml version="1.0" encoding="utf-8"?>
<!-- One linked card machine: name, serial, status badge and the Remove action. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/machineDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_light" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                android:id="@+id/machineName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/top_title"
                android:textSize="@dimen/text_body" />

            <com.anokix.distributorapp.ui.views.RobotoTextView
                android:id="@+id/machineSerial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_micro" />
        </LinearLayout>

        <com.anokix.distributorapp.ui.views.RobotoTextView
            android:id="@+id/machineStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_badge_success"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/success"
            android:textSize="@dimen/text_micro" />

        <com.anokix.distributorapp.ui.views.RobotoBoldTextView
            android:id="@+id/machineRemove"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="4dp"
            android:paddingVertical="6dp"
            android:text="@string/pos_remove"
            android:textColor="@color/danger"
            android:textSize="@dimen/text_body_sm" />
    </LinearLayout>
</LinearLayout>
