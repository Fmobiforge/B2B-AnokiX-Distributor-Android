<?xml version="1.0" encoding="utf-8"?>
<!--
  Generate a report (New-Design/Report/3.Generate-Report.png, 4.Generate-Report-Options.png).

  A bottom sheet rather than a centre dialog: both fields are pickers, and a sheet keeps
  them within thumb reach. Report and Period are the whole form — a report already
  carries its category, so asking for one here would be a second way to say the same
  thing (the list screen keeps its Category filter, which is a different job).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top"
    android:orientation="vertical"
    android:paddingBottom="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pill_neutral" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp">

        <com.anokix.distributorapp.ui.views.RobotoBoldTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/generate_report_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_headline" />

        <ImageView
            android:id="@+id/sheetClose"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel_btn"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp">

        <com.anokix.distributorapp.ui.views.RobotoTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_info_box"
            android:lineSpacingExtra="2dp"
            android:padding="12dp"
            android:text="@string/generate_report_help"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption" />

        <com.anokix.distributorapp.ui.views.RobotoBoldTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/report_label"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_caption" />

        <LinearLayout
            android:id="@+id/reportField"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_login_input"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <com.anokix.distributorapp.ui.views.RobotoTextView
                android:id="@+id/reportValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/choose_a_report"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:rotation="90"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- The chosen report's "about" line, so the user knows what they are asking for. -->
        <com.anokix.distributorapp.ui.views.RobotoTextView
            android:id="@+id/reportAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:visibility="gone" />

        <com.anokix.distributorapp.ui.views.RobotoBoldTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/period_label"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_caption" />

        <LinearLayout
            android:id="@+id/periodField"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_login_input"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <com.anokix.distributorapp.ui.views.RobotoTextView
                android:id="@+id/periodValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_calendar"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                android:id="@+id/sheetCancel"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_login_button_outlined"
                android:gravity="center"
                android:text="@string/cancel_btn"
                android:textColor="@color/purple_primary"
                android:textSize="15sp" />

            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                android:id="@+id/sheetSubmit"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_login_button_primary"
                android:gravity="center"
                android:text="@string/generate_btn"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
