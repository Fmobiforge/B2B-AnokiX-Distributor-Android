<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerContent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/drawer_bg"
    android:orientation="vertical">

    <!-- Drawer header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/drawer_padding_horizontal"
        android:paddingTop="48dp"
        android:paddingBottom="@dimen/spacing_xl">

        <com.anokix.distributorapp.ui.views.ResizableImageView
            android:layout_width="@dimen/drawer_logo_width"
            android:layout_height="wrap_content"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_anokix_logo" />

        <com.anokix.distributorapp.ui.views.RobotoTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_drawer_portal_badge"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_xs"
            android:text="@string/distributor_portal"
            android:textColor="@color/drawer_badge_text"
            android:textSize="@dimen/text_label" />
    </LinearLayout>

    <!-- Menu items -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/drawerMenuList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="@dimen/spacing_xs"
        android:paddingBottom="@dimen/spacing_lg"
        android:scrollbars="none" />

    <!-- Logout (pinned to the bottom) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="@dimen/drawer_padding_horizontal"
        android:background="@color/drawer_divider" />

    <LinearLayout
        android:id="@+id/drawerLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/drawer_padding_horizontal"
        android:paddingVertical="@dimen/spacing_lg">

        <ImageView
            android:layout_width="@dimen/drawer_icon_size"
            android:layout_height="@dimen/drawer_icon_size"
            android:contentDescription="@null"
            android:src="@drawable/ic_logout"
            app:tint="@color/drawer_text_muted" />

        <com.anokix.distributorapp.ui.views.RobotoTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1"
            android:text="@string/logout"
            android:textColor="@color/drawer_text_muted"
            android:textSize="@dimen/drawer_text_size" />
    </LinearLayout>
</LinearLayout>
