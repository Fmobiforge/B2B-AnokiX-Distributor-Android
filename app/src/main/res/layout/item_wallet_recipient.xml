<?xml version="1.0" encoding="utf-8"?>
<!-- One avatar in the horizontal "Send Money Quickly" strip. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="84dp"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <FrameLayout
        android:id="@+id/recipientAvatar"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_circle_avatar">

        <com.anokix.distributorapp.ui.views.RobotoBoldTextView
            android:id="@+id/recipientInitial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/white"
            android:textSize="@dimen/text_headline" />

        <ImageView
            android:id="@+id/recipientAddIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_add"
            android:visibility="gone"
            app:tint="@color/text_secondary" />
    </FrameLayout>

    <com.anokix.distributorapp.ui.views.RobotoTextView
        android:id="@+id/recipientName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_caption" />

    <com.anokix.distributorapp.ui.views.RobotoLightTextView
        android:id="@+id/recipientAccount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/text_label" />
</LinearLayout>
