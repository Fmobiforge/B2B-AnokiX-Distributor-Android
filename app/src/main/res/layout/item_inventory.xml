<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="0dp"
    app:contentPadding="14dp"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== Identity ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/itemSwatch"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_inventory_swatch">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:alpha="0.9"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_package"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:id="@+id/itemName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.AnokiX.Title"
                    android:textSize="@dimen/text_body" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.anokix.distributorapp.ui.views.RobotoTextView
                        android:id="@+id/itemSku"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_neutral"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_micro" />

                    <com.anokix.distributorapp.ui.views.RobotoTextView
                        android:id="@+id/itemCategory"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_tertiary"
                        android:textSize="@dimen/text_micro" />
                </LinearLayout>
            </LinearLayout>

            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                android:id="@+id/itemStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_success"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/success"
                android:textSize="@dimen/text_micro" />
        </LinearLayout>

        <!-- ===== Capacity ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.anokix.distributorapp.ui.views.RobotoTextView
                style="@style/InventoryStatLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/inventory_on_hand" />

            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                android:id="@+id/itemCapacityPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/success"
                android:textSize="@dimen/text_micro" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                android:id="@+id/itemUnits"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_title" />

            <com.anokix.distributorapp.ui.views.RobotoTextView
                android:id="@+id/itemWarehouse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:drawablePadding="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_micro"
                app:drawableStartCompat="@drawable/ic_location_pin" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/itemStockProgress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progressDrawable="@drawable/bg_stock_track" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/border_light" />

        <!-- ===== Value + actions ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    style="@style/InventoryStatLabel"
                    android:text="@string/inventory_stock_value" />

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:id="@+id/itemValue"
                    style="@style/InventoryStatValue"
                    android:textColor="@color/purple_primary" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/itemViewButton"
                style="@style/InventoryIconButton"
                android:contentDescription="@string/view_details"
                android:src="@drawable/ic_eye"
                app:tint="@color/purple_primary" />

            <ImageButton
                android:id="@+id/itemMoreButton"
                style="@style/InventoryIconButton"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/more_actions"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
