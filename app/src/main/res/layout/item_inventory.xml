<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="0dp"
    app:contentPadding="12dp"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <View
                android:id="@+id/itemSwatch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_inventory_swatch" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                    android:id="@+id/itemName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.AnokiX.Title"
                    android:textSize="@dimen/text_body" />

                <com.anokix.distributorapp.ui.views.RobotoTextView
                    android:id="@+id/itemMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <com.anokix.distributorapp.ui.views.RobotoTextView
                android:id="@+id/itemStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_success"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/success"
                android:textSize="@dimen/text_micro" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                android:id="@+id/itemUnits"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_caption" />

            <com.anokix.distributorapp.ui.views.RobotoTextView
                android:id="@+id/itemWarehouse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_micro" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/itemStockProgress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progressDrawable="@drawable/bg_stock_progress" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.anokix.distributorapp.ui.views.RobotoBoldTextView
                android:id="@+id/itemValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:textColor="@color/purple_primary"
                android:textSize="@dimen/text_body" />

            <ImageButton
                android:id="@+id/itemViewButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_search_bar"
                android:contentDescription="@string/view_details"
                android:padding="8dp"
                android:src="@drawable/ic_eye"
                app:tint="@color/text_secondary" />

            <ImageButton
                android:id="@+id/itemMoreButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_search_bar"
                android:contentDescription="@string/more_actions"
                android:padding="8dp"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
