<?xml version="1.0" encoding="utf-8"?>
<!-- Capacity bar on an inventory card: soft track, coloured fill clipped to progress.
     Only the progress layer is tinted at bind time so the track stays neutral. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/border_light" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/success" />
                <corners android:radius="3dp" />
            </shape>
        </clip>
    </item>
</layer-list>
