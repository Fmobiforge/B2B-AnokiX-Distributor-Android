<?xml version="1.0" encoding="utf-8"?>
<!-- Violet primary action of the Add Product flow (Continue / Verify / Use this product). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/hc_violet_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hc_violet_dark" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hc_violet" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
