<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Required to show push notifications on Android 13+ (runtime-requested). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".AnokiXApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.AnokiXDistributor">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_key" />

        <!-- Firebase Cloud Messaging: receives push tokens + messages. -->
        <service
            android:name=".messaging.AxFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Defaults applied to notifications that arrive while the app is backgrounded. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notifications" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/purple_primary" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/fcm_default_channel_id" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AnokiXDistributor.Login">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.WelcomeActivity"
            android:exported="false"
            android:theme="@style/Theme.AnokiXDistributor.Login" />

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.AnokiXDistributor.Login">
        </activity>

        <activity
            android:name=".ui.ForgotPasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.AnokiXDistributor.Login" />

        <activity
            android:name=".ui.PendingApprovalActivity"
            android:exported="false" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />

        <activity android:name=".ui.StoresActivity" android:exported="false" />
        <activity android:name=".ui.AddEditStoreActivity" android:exported="false" />
        <activity android:name=".ui.TradersActivity" android:exported="false" />
        <activity android:name=".ui.CreateTraderActivity" android:exported="false" />
        <activity android:name=".ui.RegisterDistributorActivity" android:exported="false" />
        <activity android:name=".ui.RegisterSubmittedActivity" android:exported="false" />
        <activity android:name=".ui.ProductsActivity" android:exported="false" />
        <activity android:name=".ui.AddProductOptionsActivity" android:exported="false" />
        <activity android:name=".ui.CreateProductActivity" android:exported="false" />
        <activity android:name=".ui.InventoryDetailActivity" android:exported="false" />
        <activity android:name=".ui.CardMachineActivity" android:exported="false" />
        <activity android:name=".ui.WarehouseStaffActivity" android:exported="false" />
        <activity android:name=".ui.OrderDetailActivity" android:exported="false" />
        <activity android:name=".ui.PromotionsActivity" android:exported="false" />
        <activity android:name=".ui.CreatePromotionActivity" android:exported="false" />
        <activity android:name=".ui.ViewPromotionActivity" android:exported="false" />
        <activity android:name=".ui.FinancesActivity" android:exported="false" />

        <!--
            anokiX wallet. Exported with the anokix://wallet deep link so PayCloud's
            hosted checkout can send the user straight back here after a top-up; the
            screen then polls api/common/topup/status for the credit.
        -->
        <activity
            android:name=".ui.WalletActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="anokix" android:host="wallet" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.ReportsActivity" android:exported="false" />
        <activity android:name=".ui.DeliveriesActivity" android:exported="false" />
        <activity android:name=".ui.DeliveryDetailActivity" android:exported="false" />
        <activity android:name=".ui.ReturnsActivity" android:exported="false" />
        <activity android:name=".ui.ReturnDetailActivity" android:exported="false" />
        <activity android:name=".ui.AirtimeActivity" android:exported="false" />
        <activity android:name=".ui.NotificationsActivity" android:exported="false" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.SettingsProfileActivity" android:exported="false" />
        <activity android:name=".ui.SettingsBusinessActivity" android:exported="false" />
        <activity android:name=".ui.SettingsNotificationsActivity" android:exported="false" />
        <activity android:name=".ui.SettingsSecurityActivity" android:exported="false" />
        <activity android:name=".ui.SettingsPreferencesActivity" android:exported="false" />
    </application>

</manifest>
